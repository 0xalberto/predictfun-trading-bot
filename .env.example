PREDICT_API_KEY=pred_sk_your_key_here
PREDICT_APP_ID=
PREDICT_API_URL=https://api.predict.fun
PREDICT_WS_URL=wss://ws.predict.fun/ws

# EOA private key, or the Privy wallet key exported from predict.fun account settings
WALLET_PRIVATE_KEY=
# Required when trading through a Predict smart-wallet account (deposit address)
PREDICT_ACCOUNT_ADDRESS=
# BNB RPC for on-chain approvals (default public Binance seed)
RPC_URL=https://bsc-dataseed.binance.org
# Optional size override for `bun run order` / `bun run paper` / `bun run live` (default 5 shares)
ORDER_SHARES=5
# Pre-signed BUY orders per bucket when a 5m market starts (YES/NO × 5 and 10 shares)
PRESIGN_PER_BUCKET=100
# Paper fill delay after signal, matching order POST latency (default 300)
ORDER_POST_LATENCY_MS=300
# Optional paper PnL JSON path (default paper-pnl.json)
PAPER_PNL_PATH=paper-pnl.json

# OBI strategy: "legacy" = raw ±80 / ±30, "predictive" = 300ms-ahead momentum
OBI_MODE=legacy
EXECUTION_LATENCY_MS=300
PREDICTION_HORIZON_MS=300
USE_MEASURED_LATENCY=false
EARLY_ENTRY_OBI=40
BULLISH_ENTRY_PREDICTED_OBI=80
BEARISH_ENTRY_PREDICTED_OBI=-80
YES_EXIT_OBI=30
NO_EXIT_OBI=-30
MIN_PERSISTENCE=0.70
MIN_EXIT_PERSISTENCE=0.70
EMA_FAST_MS=50
EMA_SLOW_MS=200
VELOCITY_LOOKBACK_MS=100
ACCELERATION_LOOKBACK_MS=100
USE_MICROPRICE_CONFIRMATION=true
# MIN_BULLISH_VELOCITY is optional. Default = (80 - 40) / 0.3s = 1.33 OBI/sec
# (133 on the 0-100 display scale). Calibrate from OBI_SIGNAL velocity at legacy +80 crossings.
# MIN_BULLISH_VELOCITY=1.33
# MIN_BEARISH_VELOCITY=1.33
OBI_SIGNAL_LOG=false
OBI_SIGNAL_LOG_EVERY_MS=0
